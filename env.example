# Synology MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Synology NAS connection details
SYNOLOGY_URL=https://192.168.1.100:5001
SYNOLOGY_USERNAME=your_username
SYNOLOGY_PASSWORD=your_password

# Optional: 2FA / OTP (one-shot, first login only — for persistent reuse,
# migrate to ~/.config/synology-mcp/settings.json and store `device_id` per-NAS)
# SYNOLOGY_OTP_CODE=123456

# Optional: Server settings
MCP_SERVER_NAME=synology-mcp-server
MCP_SERVER_VERSION=1.0.0

# Optional: Session and security settings
SESSION_TIMEOUT=3600
AUTO_LOGIN=false
VERIFY_SSL=true  # false disables verification (avoid); or set to a CA bundle file path
                  # (e.g. /etc/ssl/certs/my-ca.pem) to trust a private CA/self-signed cert
                  # without disabling verification. REQUESTS_CA_BUNDLE also works as a
                  # global override.
RESTRICTED_MODE=true  # Only browsing/monitoring tools are exposed; set to false to enable the full tool set
MAX_FILE_CONTENT_SIZE=1000000  # get_file_content refuses files larger than this (bytes)

# Optional: Debug settings
DEBUG=false
LOG_LEVEL=INFO