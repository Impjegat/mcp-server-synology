# Synology MCP Server configuration (environment variables).
#
# RECOMMENDED: manual authentication. Nothing in this file is needed for it, and no
# environment file should ever hold your NAS password or one-time code. You sign in
# yourself on a private page; the AI application never receives the password. See
# docs/MANUAL_AUTHENTICATION.md. The only environment settings the broker takes are the
# non-secret ones below, and it reads them from its own environment, not from a .env.
#
#   RESTRICTED_MODE=true          # only browsing and monitoring tools (the default)
#   VERIFY_SSL=true               # or the path of a CA bundle for a private certificate
#   MAX_FILE_CONTENT_SIZE=1000000 # get_file_content refuses larger files (bytes)
#   LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------
# LEGACY: single-process mode. The server logs in itself, with a password it is given.
# Copy this file to .env, uncomment the three lines below and fill them in. The password
# is then readable by anything that can read this file, which is the problem manual
# authentication exists to remove. Use it only on a machine you alone use.
# ---------------------------------------------------------------------------------

# Required in legacy mode: Synology NAS connection details (HTTPS only)
# SYNOLOGY_URL=https://192.168.1.100:5001
# SYNOLOGY_USERNAME=your_username
# SYNOLOGY_PASSWORD=your_password

# Optional in legacy mode: 2FA / OTP (one-shot, first login only — for persistent reuse,
# migrate to ~/.config/synology-mcp/settings.json and store `device_id` per-NAS)
# SYNOLOGY_OTP_CODE=123456

# Optional: Server settings
MCP_SERVER_NAME=synology-mcp-server
MCP_SERVER_VERSION=1.0.0

# Optional: Session and security settings
SESSION_TIMEOUT=3600
AUTO_LOGIN=false
VERIFY_SSL=true  # false disables verification (avoid); or set to a CA bundle file path
                  # (e.g. /etc/ssl/certs/my-ca.pem) to trust a private CA/self-signed cert
                  # without disabling verification. REQUESTS_CA_BUNDLE also works as a
                  # global override.
RESTRICTED_MODE=true  # Only browsing/monitoring tools are exposed; set to false to enable the full tool set
MAX_FILE_CONTENT_SIZE=1000000  # get_file_content refuses files larger than this (bytes)

# Optional: Debug settings
DEBUG=false
LOG_LEVEL=INFO
