{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own view (the window's main view) may do. The view that shows the broker's page is a remote origin and gets none of this.",
  "webviews": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "allow-get-status",
    "allow-start-broker",
    "allow-stop-broker",
    "allow-open-broker",
    "allow-place-page",
    "allow-hide-page",
    "allow-trust-certificate",
    "allow-prepare-update"
  ]
}
