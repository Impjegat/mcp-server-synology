# .dockerignore - Exclude files from Docker build context

# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation and assets
README.md
*.md
assets/

# Docker files (don't need them inside container)
Dockerfile
docker-compose.yml
.dockerignore

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Test files
test_*
*_test.py

# Credentials — never let these reach the build context, even if a future
# COPY becomes broader than the current targeted src/+main.py copies.
.env
.env.*
settings*.json

# Manual-authentication state, tokens, keys and local configuration: none of it
# belongs in an image (the broker and adapter read theirs from mounted files).
# (the **/ forms match at any depth; a bare pattern matches only at the top)
**/.env
**/.env.*
**/settings*.json
**/broker-policy.json
**/owner.json
**/adapter.json
**/broker.env
**/*.token
**/*.pem
**/*.key
**/*.p12
**/*.pfx
config/
deploy/
docs/
plans/
tests/
scripts/
skills/
.github/
