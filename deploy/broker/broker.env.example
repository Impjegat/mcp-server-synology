# Host names and paths for deploy/broker/docker-compose.yml. Copy to broker.env.
# Nothing in this file is a secret: no password, no one-time code, no token. If you find
# yourself wanting to put one here, stop; the broker takes none of them from any file or
# environment (docs/MANUAL_AUTHENTICATION.md).

# The name clients and the owner's browser use for this host. The TLS certificate must be
# valid for exactly this name, and it is also the WebAuthn relying-party id.
BROKER_HOST=broker.example.lan

# The account that owns the three directories below (`id -u` and `id -g` for it). Not root,
# and not an account an AI application can act as.
BROKER_UID=10001
BROKER_GID=10001

# Addresses on THIS host to publish on. Give the address of the interface the clients (and,
# for the private page, only the owner's devices) can reach; there is no default, so
# nothing is published by accident. 127.0.0.1 publishes to this host only.
BROKER_BIND_ADDRESS=192.168.1.20
BROKER_PRIVATE_BIND_ADDRESS=192.168.1.20
# BROKER_MCP_PORT=8443
# BROKER_PRIVATE_PORT=8444

# Directories on this host (mode 0700, owned by BROKER_UID):
#   config  settings.json (see config/settings.broker.example.json) and broker-policy.json
#           (see config/broker.example.json), both mode 0600
#   tls     cert.pem and key.pem
#   state   written by the broker: owner.json, the owner's public passkey
BROKER_CONFIG_DIR=/opt/synology-broker/synology-mcp
BROKER_TLS_DIR=/opt/synology-broker/tls
BROKER_STATE_DIR=/opt/synology-broker/state

# Verification of the NAS's certificate: true, or the path of a CA bundle as the broker
# sees it (for example /config/synology-mcp/nas-ca.pem). `false`, an empty value and a path
# that does not exist are refused: the broker will not start.
# NAS_VERIFY_SSL=true
# BROKER_RESTRICTED_MODE=true
# BROKER_LOG_LEVEL=INFO
